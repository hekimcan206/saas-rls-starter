{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "App": "",
    "Admin": "",
    "Migrator": ""
  },
  "Tenancy": {
    "Source": "Claim",
    "ClaimType": "tenant_id",
    "HeaderName": "X-Tenant-Id",
    "SessionVariable": "app.tenant_id",
    "RefuseUnsafeDatabase": true
  },
  "Auth": {
    "Issuer": "saas-rls-starter",
    "Audience": "saas-rls-starter-api",
    "SigningKey": "",
    "EnableDevTokens": false
  },
  "OpenApi": {
    "Enabled": false
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
