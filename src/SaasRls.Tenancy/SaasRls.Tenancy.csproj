<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Request-scoped tenant context for PostgreSQL row-level security: tenant resolution, transaction-scoped session variable, Npgsql and Dapper integration, and a startup guard that refuses unsafe database roles.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Dapper" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SaasRls.UnitTests" />
  </ItemGroup>

</Project>
