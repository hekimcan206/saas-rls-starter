# Development-only values. docker compose reads .env if present; every variable has a safe local default.
POSTGRES_PASSWORD=postgres-dev-only
MIGRATOR_PASSWORD=migrator-dev-only
APP_PASSWORD=app-dev-only
ADMIN_PASSWORD=admin-dev-only
AUTH_SIGNING_KEY=dev-only-signing-key-change-me-0123456789abcdef
POSTGRES_PORT=58932
PGBOUNCER_PORT=58933
API_PORT=58980
# Point at an OTLP collector to export traces and metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=
